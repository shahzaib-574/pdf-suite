{
  "name": "pdf-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:website": "tsc -b && vite build --mode website --outDir dist-web",
    "dev:website": "vite --mode website --port 5174",
    "lint": "oxlint src scripts",
    "preview": "vite preview",
    "docx-selfcheck": "tsx scripts/docx-selfcheck.ts && tsx scripts/pdf-word-fidelity-selfcheck.ts",
    "pdf-selfcheck": "tsx scripts/pdf-tools-selfcheck.ts",
    "pdf-docx-preview": "tsx scripts/pdf-to-docx-preview.ts",
    "ocr-preview": "tsx scripts/ocr-preview.ts",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:sync:debug": "tsc -b && vite build --mode android-debug && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync:debug && cd android && gradlew.bat assembleDebug",
    "android:bundle": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "verify:android-artifact": "node scripts/verify-android-artifact.mjs",
    "verify:elf-alignment": "node scripts/verify-elf-alignment.mjs",
    "verify:elf-alignment:self-test": "node scripts/verify-elf-alignment.test.mjs",
    "verify:store-assets": "node scripts/verify-store-assets.mjs",
    "dependency-selfcheck": "node scripts/dependency-selfcheck.mjs",
    "quality-selfcheck": "tsx scripts/quality-selfcheck.ts",
    "product-quality-selfcheck": "node tests/browser/product-quality-selfcheck.mjs && node tests/browser/conversion-quality-selfcheck.mjs && node tests/browser/scan-preview-selfcheck.mjs && node tests/browser/scan-edge-selfcheck.mjs && node tests/browser/pdf-word-fidelity-selfcheck.mjs",
    "verify:ads": "node scripts/verify-ads.mjs",
    "ads-selfcheck": "tsx scripts/ads-selfcheck.ts",
    "verify:monetization": "node scripts/verify-monetization.mjs",
    "browser-selfcheck": "tsx tests/browser/ui-selfcheck.ts && node tests/browser/edge-selfcheck.mjs && node tests/browser/engine-selfcheck.mjs",
    "ota:setup": "node scripts/ota-setup.mjs",
    "ota:push:preview": "node scripts/ota-push.mjs preview",
    "ota:push:production": "node scripts/ota-push.mjs production"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.2",
    "@capawesome/capacitor-live-update": "^8.4.4",
    "@gsap/react": "^2.1.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "fast-xml-parser": "^5.11.2",
    "gsap": "^3.15.0",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "pdf-lib": "^1.17.1",
    "pdf-lib-encrypt": "^1.0.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.86.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.1"
  },
  "overrides": {
    "@capacitor/cli": {
      "xcode": {
        "uuid": "11.1.1"
      }
    }
  }
}
