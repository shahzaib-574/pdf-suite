# Copy to android/keystore.properties and keep the real file private.
# Relative storeFile paths are resolved from the android/ directory. This example
# keeps the keystore in a sibling of the repository, not inside source control.
storeFile=../../release-keystore/ream-upload.jks
storePassword=replace-with-secure-password
keyAlias=ream-upload
keyPassword=replace-with-secure-password
