# Android debug builds use Google's official test banner and never request live ads.
VITE_ADMOB_TEST_MODE=true
# Android emulators are UMP test devices automatically. Change this to US or
# OTHER to exercise those account-side privacy-message paths deterministically.
VITE_UMP_DEBUG_GEOGRAPHY=EEA
# Physical devices require the hashed test-device ID printed by the UMP SDK.
# Keep this empty in source control and set a comma-separated value locally.
VITE_UMP_TEST_DEVICE_IDS=
